# ============================================================
# Copy to .env.local for local dev.
# In production these go in Vercel → Settings → Environment Variables.
# NEVER commit real values.
#
# Only the two NEXT_PUBLIC_* vars below may be prefixed that way. Anything
# with NEXT_PUBLIC_ is compiled into the browser bundle and is public.
# ============================================================

# --- Supabase (server) ----------------------------------------
# Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
# service_role key. Bypasses RLS. Server-only, always.
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase (dashboard, browser) ----------------------------
# Same project. The anon key is public by design — every query it makes is
# filtered by the RLS policies in schema.sql using the logged-in user's JWT.
# Without these two the dashboard cannot load; the webhook still works.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- AI provider ----------------------------------------------
# Which provider the agent talks to. All three speak the OpenAI
# chat-completions dialect, so switching is config only.
#
#   openrouter  free Kimi route, no card. ~50 requests/day — DEMO ONLY.
#   kimi        Moonshot direct. Prepaid, ~$1 minimum top-up. Use for pilots.
#   qwen        Alibaba Model Studio.
AI_PROVIDER=openrouter

# openrouter.ai → Keys (no payment method needed for :free models),
# platform.moonshot.ai → API Keys for kimi, or Alibaba Model Studio for qwen.
AI_API_KEY=

# Only set these to override the provider defaults in lib/pricing.ts — when a
# model gets renamed, or to point the whole thing at OpenRouter.
# Run `npm run models` to see what the provider actually accepts.
# AI_BASE_URL=
# AI_MODEL_FAST=
# AI_MODEL_SMART=

# Rate overrides, USD per million tokens. Set these when the published price
# changes, otherwise the margin figure on the dashboard quietly goes stale.
# AI_FAST_INPUT_PER_M=
# AI_FAST_OUTPUT_PER_M=
# AI_FAST_CACHED_PER_M=
# AI_SMART_INPUT_PER_M=
# AI_SMART_OUTPUT_PER_M=
# AI_SMART_CACHED_PER_M=

# --- WhatsApp Cloud API ---------------------------------------
# Meta app → WhatsApp → API Setup
WHATSAPP_TOKEN=
# Meta app → Settings → Basic → App Secret. Used to verify webhook signatures.
WHATSAPP_APP_SECRET=
# Any random string you invent. Paste the SAME value into Meta's webhook config.
WHATSAPP_VERIFY_TOKEN=
# Graph API version. Bump deliberately — Meta deprecates these on a schedule.
WHATSAPP_GRAPH_VERSION=v21.0

# --- Cron -----------------------------------------------------
# Random string. Protects /api/cron/restock from being triggered by strangers.
CRON_SECRET=

# --- Restock template (must be APPROVED in Meta first) --------
RESTOCK_TEMPLATE_NAME=restock_alert
RESTOCK_TEMPLATE_LANG=en
RESTOCK_MAX_PER_RUN=50

# --- Cost accounting ------------------------------------------
# NGN per USD, expressed in kobo. 135000 = ₦1,350/$.
# Check this against the real rate periodically — it's the only thing
# converting the provider's USD billing into the margin figure on the dashboard.
USD_TO_MINOR=135000

# --- Abuse throttle -------------------------------------------
# Hard ceiling on what one customer can cost. Past THROTTLE_MAX_REPLIES
# inbound messages in THROTTLE_WINDOW_SECONDS, the agent stops answering that
# thread until the window passes. Nothing else bounds per-customer spend.
THROTTLE_MAX_REPLIES=12
THROTTLE_WINDOW_SECONDS=120

# --- Agent behaviour ------------------------------------------
# Extra JSON merged into every chat-completions request, passed to the
# provider verbatim. Reasoning/thinking toggles are provider-specific and are
# not part of the OpenAI-compatible surface, so they go here. Qwen takes
# enable_thinking; sending an unknown field is a 400 on some gateways, so set
# this only when you know the provider accepts it.
# AI_EXTRA_BODY={"enable_thinking":false}
